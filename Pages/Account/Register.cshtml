@page
@model movieRecommender.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="row">
    <div class="col-md-5">
        <h1>Sign up</h1>
        <p class="text-muted">Create an account so your ratings and watchlist have somewhere to live.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="you@example.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.DisplayName" class="form-control" autocomplete="nickname" placeholder="Ava" />
                <label asp-for="Input.DisplayName"></label>
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="At least 8 characters" />
                <label asp-for="Input.Password"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Repeat it" />
                <label asp-for="Input.ConfirmPassword"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Sign up</button>
        </form>

        <p class="mt-3">
            Already have an account? <a asp-page="/Account/Login">Log in</a>.
        </p>
    </div>
</div>

@section Scripts {
    @* A convenience only. Every rule above is enforced server-side (NFR-007). *@
    <partial name="_ValidationScriptsPartial" />
}
