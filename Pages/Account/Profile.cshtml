@page
@model movieRecommender.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Your account";
}

<h1>Your account</h1>

<dl class="row">
    <dt class="col-sm-3">Display name</dt>
    <dd class="col-sm-9">@Model.Account.DisplayName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Account.Email</dd>

    <dt class="col-sm-3">Member since</dt>
    <dd class="col-sm-9">@Model.Account.CreatedAt.ToLocalTime().ToString("d MMMM yyyy")</dd>
</dl>

<form method="post" asp-page="/Account/Logout">
    <button type="submit" class="btn btn-outline-secondary">Log out</button>
</form>
