@page
@model movieRecommender.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row">
    <div class="col-md-5">
        <h1>Log in</h1>

        <form method="post">
            @* FR-014: carried through the round trip so a bounced request lands back
               where it started. Validated as local before it is honoured. *@
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="you@example.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Your password" />
                <label asp-for="Input.Password"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe"></label>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
        </form>

        <p class="mt-3">
            No account yet? <a asp-page="/Account/Register">Sign up</a>.
        </p>

        @* 003-004 FR-018/FR-019. Not hidden, not disabled — simply not rendered, and the
           handler behind it answers not-found, because NFR-003 rules out a client-side
           gate. Outside Development IsAvailable is false and none of this exists. *@
        @if (Model.DemoSignIn.IsAvailable)
        {
            <div class="mt-4 pt-3 border-top">
                <h2 class="h6 text-muted">Demo accounts</h2>
                <p class="form-text mt-0">
                    Development only. These are ordinary accounts with no privileges — they
                    are simply already full of ratings.
                </p>

                @foreach (var option in Model.DemoSignIn.Options)
                {
                    <form method="post" asp-page-handler="Demo" class="mb-2">
                        <input type="hidden" name="email" value="@option.Email" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-outline-secondary w-100 text-start">
                            <strong>Sign in as @option.DisplayName</strong>
                            <span class="d-block small text-muted">@option.TasteLabel</span>
                        </button>
                    </form>
                }

                <p class="form-text mb-0">
                    @* FR-017/SC-017: the same credentials typed into the form above also work. *@
                    Or type them: @string.Join(", ", Model.DemoSignIn.Options.Select(o => o.Email))
                    — password <code>@Model.DemoSignIn.Options[0].Password</code>.
                </p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
