@* FR-012: who you are, or how to become someone. *@
@using Microsoft.AspNetCore.Identity
@using movieRecommender.Data
@using movieRecommender.Identity
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            @* Read from the cookie's claim, not the database — see AppUserClaimsPrincipalFactory. *@
            <a class="nav-link text-dark" asp-page="/Account/Profile">@User.DisplayName()</a>
        </li>
        <li class="nav-item">
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" class="nav-link btn btn-link text-dark border-0">Log out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Account/Register">Sign up</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-page="/Account/Login">Log in</a>
        </li>
    }
</ul>
