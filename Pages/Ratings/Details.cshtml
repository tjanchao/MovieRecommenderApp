@page
@model movieRecommender.Pages.Ratings.DetailsModel
@{
    ViewData["Title"] = Model.Rating.Film.Title;
}

<h1 class="h3">@Model.Rating.Film.Title <span class="text-muted">(@Model.Rating.Film.ReleaseYear)</span></h1>

<dl class="row">
    <dt class="col-sm-3">You thought</dt>
    <dd class="col-sm-9">@Model.Rating.Sentiment</dd>

    <dt class="col-sm-3">Rated</dt>
    <dd class="col-sm-9">@Model.Rating.RatedAt.ToLocalTime().ToString("d MMMM yyyy")</dd>

    <dt class="col-sm-3">Genres</dt>
    <dd class="col-sm-9">@string.Join(", ", Model.Rating.Film.Genres)</dd>

    @if (Model.Rating.Film.RuntimeMin is int runtime)
    {
        <dt class="col-sm-3">Runtime</dt>
        <dd class="col-sm-9">@runtime minutes</dd>
    }
</dl>

@if (!string.IsNullOrWhiteSpace(Model.Rating.Film.Synopsis))
{
    <p>@Model.Rating.Film.Synopsis</p>
}

<p><a asp-page="/Ratings/Index">Back to your ratings</a></p>
